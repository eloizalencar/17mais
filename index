    /* ==========================================
       MECÂNICA DO SUDOKU
       ========================================== */
    function loadLevel(lvlIndex) {
      currentLevel = lvlIndex;
      const lvlData = LEVELS[lvlIndex];
      document.getElementById('level-indicator').innerText = `Nível ${lvlIndex + 1} de 5`;
      document.getElementById('level-difficulty').innerText = lvlData.difficulty;

      // Clona matriz inicial
      currentBoard = lvlData.initial.map(row => [...row]);
      renderBoard();
    }

    function renderBoard() {
      const grid = document.getElementById('sudoku-grid');
      grid.innerHTML = '';
      selectedCell = null;

      const lvlData = LEVELS[currentLevel];

      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          const val = currentBoard[r][c];
          const isFixed = lvlData.initial[r][c] !== 0;

          const cell = document.createElement('div');
          cell.className = 'cell';
          if (isFixed) cell.classList.add('fixed');
          if (!isFixed && val !== 0) cell.classList.add('user');

          cell.innerText = val !== 0 ? val : '';
          cell.dataset.row = r;
          cell.dataset.col = c;

          cell.onclick = () => selectCell(r, c);
          grid.appendChild(cell);
        }
      }
    }

    function selectCell(r, c) {
      const lvlData = LEVELS[currentLevel];
      if (lvlData.initial[r][c] !== 0) return; // Células fixas não editam

      selectedCell = { r, c };
      const allCells = document.querySelectorAll('.cell');
      allCells.forEach(cell => {
        cell.classList.remove('selected', 'highlight');
        const cr = parseInt(cell.dataset.row);
        const cc = parseInt(cell.dataset.col);
        if (cr === r && cc === c) {
          cell.classList.add('selected');
        } else if (cr === r || cc === c) {
          cell.classList.add('highlight');
        }
      });
    }

    function pressKey(num) {
      if (!selectedCell) return;
      const { r, c } = selectedCell;
      currentBoard[r][c] = num;

      playNote(300 + num * 40, 0, 0.08);
      renderBoard();
      selectCell(r, c);
      checkBoardAuto();
    }

    function clearUserBoard() {
      const lvlData = LEVELS[currentLevel];
      currentBoard = lvlData.initial.map(row => [...row]);
      renderBoard();
    }

    function giveHint() {
      const lvlData = LEVELS[currentLevel];
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (currentBoard[r][c] === 0) {
            currentBoard[r][c] = lvlData.solution[r][c];
            renderBoard();
            selectCell(r, c);
            playNote(600, 0, 0.15);
            checkBoardAuto();
            return;
          }
        }
      }
    }

    function checkBoardAuto() {
      const lvlData = LEVELS[currentLevel];
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (currentBoard[r][c] !== lvlData.solution[r][c]) {
            return false;
          }
        }
      }
      // Se chegou aqui, Sudoku completo e correto!
      onSudokuCompleted();
      return true;
    }

